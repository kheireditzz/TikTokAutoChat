<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. BUBBLE MINI (Saat Diperkecil / Minimized) - TIDAK MENGHALANGI LAYAR -->
    <LinearLayout
        android:id="@+id/layoutBubble"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_floating_bubble_light"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        android:elevation="16dp">

        <View
            android:id="@+id/bubbleStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_indicator_dot" />

        <TextView
            android:id="@+id/tvBubbleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AutoChat"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/tvBubbleSentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 kirim"
            android:textColor="#10B981"
            android:textStyle="bold"
            android:textSize="10sp"
            android:layout_marginStart="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛶"
            android:textColor="#FE2C55"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- 2. CARD LENGKAP - TEMA WHITE CLEAN DENGAN AKSEN TIKTOK -->
    <LinearLayout
        android:id="@+id/layoutExpanded"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_glass"
        android:padding="12dp"
        android:elevation="16dp">

        <!-- Header Bar (Drag Handle) -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_indicator_dot"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TikTok AutoChat"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siap dikirimkan"
                    android:textColor="#64748B"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Pill Status Lisensi / Trial -->
            <TextView
                android:id="@+id/tvFloatingLicensePill"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_stepper_btn"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:gravity="center"
                android:text="👑 PRO"
                android:textColor="#D97706"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <!-- Tombol Perkecil (—) -->
            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:background="@drawable/bg_circle_btn_white"
                android:text="—"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <!-- Tombol Tutup (✕) -->
            <TextView
                android:id="@+id/btnCloseFloating"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:background="@drawable/bg_circle_btn_white"
                android:text="✕"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pesan Rotasi Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PESAN ROTASI"
                android:textColor="#64748B"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvSentCountStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Terkirim"
                android:textColor="#3B82F6"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvActiveCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 Aktif"
                android:textColor="#10B981"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Message List Container with Scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="140dp"
            android:scrollbars="vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/containerFloatingMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_input_white"
                android:padding="4dp" />
        </ScrollView>

        <!-- Tombol Tambah Chat & Kalibrasi Pin Target -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btnFloatingAddMessage"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:text="+ Chat"
                android:textColor="#FE2C55"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_btn_add"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnCalibrate"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1.4"
                android:text="📍 Kalibrasi Pin"
                android:textColor="#3B82F6"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_btn_add"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Stepper Controls Row: Jeda & Target Limit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Stepper Jeda Waktu (Detik) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_white"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginEnd="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jeda:"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/btnDelayMinus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDelayInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="4"
                    android:gravity="center"
                    android:textColor="#0F172A"
                    android:background="@null"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/btnDelayPlus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stepper Target Limit (Jumlah Pesan) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_white"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target:"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/btnTargetMinus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTargetLimitInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"
                    android:hint="0"
                    android:gravity="center"
                    android:textColor="#0F172A"
                    android:background="@null"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/btnTargetPlus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Start / Stop Button -->
        <Button
            android:id="@+id/btnToggleStart"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="▶  MULAI AUTO CHAT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tiktok_gradient"
            android:stateListAnimator="@null" />

    </LinearLayout>

</FrameLayout>
