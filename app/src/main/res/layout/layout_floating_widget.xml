<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutFloatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_card"
    android:padding="16dp"
    android:elevation="18dp">

    <!-- Top Handle & Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <!-- Live Pulse Indicator -->
        <View
            android:id="@+id/statusIndicator"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="#3FB950"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AutoChat"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Stream Automation"
                android:textColor="#6E7681"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Close Button -->
        <ImageView
            android:id="@+id/btnCloseFloating"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_circle_btn"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#8B949E"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Section Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ROTATING PRESETS"
            android:textColor="#8B949E"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvActiveCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 Aktif"
            android:textColor="#58A6FF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preset Cards Container -->
    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_input_field"
        android:padding="6dp"
        android:layout_marginBottom="12dp">

        <!-- Item 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="5dp">
            <CheckBox
                android:id="@+id/cbPreset1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:checked="true"
                android:buttonTint="#00B4D8" />
            <EditText
                android:id="@+id/etPreset1"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:text="Halo host, barangnya ready? 🔥"
                android:textColor="#F0F6FC"
                android:textSize="11.5sp"
                android:background="@null"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:singleLine="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1B212D"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- Item 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="5dp">
            <CheckBox
                android:id="@+id/cbPreset2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:checked="true"
                android:buttonTint="#00B4D8" />
            <EditText
                android:id="@+id/etPreset2"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:text="Spill promo etalase 1 dong kak 🛍️"
                android:textColor="#F0F6FC"
                android:textSize="11.5sp"
                android:background="@null"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:singleLine="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1B212D"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- Item 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="5dp">
            <CheckBox
                android:id="@+id/cbPreset3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:checked="false"
                android:buttonTint="#00B4D8" />
            <EditText
                android:id="@+id/etPreset3"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:text="Tap tap layar terus guys! ✨"
                android:textColor="#F0F6FC"
                android:textSize="11.5sp"
                android:background="@null"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Bar: Interval & Start Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interval"
                android:textColor="#8B949E"
                android:textSize="10.5sp" />

            <EditText
                android:id="@+id/etDelayInput"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:text="5"
                android:gravity="center"
                android:textColor="#00B4D8"
                android:background="@null"
                android:textSize="12sp"
                android:textStyle="bold"
                android:inputType="number"
                android:layout_marginStart="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="s"
                android:textColor="#8B949E"
                android:textSize="10.5sp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnToggleStart"
            android:layout_width="82dp"
            android:layout_height="34dp"
            android:text="START"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_action_btn"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
