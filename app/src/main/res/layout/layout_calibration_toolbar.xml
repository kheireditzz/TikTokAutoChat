<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_floating_card"
    android:elevation="12dp">

    <!-- Header & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_target_center"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KALIBRASI PIN TARGET"
                android:textColor="#FE2C55"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCalibCoordInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pin 1: Chat • Pin 2: Kirim"
                android:textColor="#64748B"
                android:textSize="9.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCalibClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/bg_circle_btn_white"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Layar bebas disentuh. Buka keyboard TikTok, geser Pin 1 ke Kolom Chat dan Pin 2 ke Tombol Kirim."
        android:textColor="#334155"
        android:textSize="10sp"
        android:layout_marginBottom="8dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnCalibSave"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.2"
            android:text="SIMPAN"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tiktok_gradient"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnCalibTest"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="TES 1X"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_black"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btnCalibResetDefault"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Default"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_input_white" />
    </LinearLayout>

</LinearLayout>
