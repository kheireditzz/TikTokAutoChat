<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER BAR (PUTIH BERSIH) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AutoChat"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#090A0F"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tvHeaderSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIKTOK ASSISTANT PRO"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHeaderAction"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_btn_white"
                android:src="@drawable/ic_tab_settings"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Pengaturan" />
        </LinearLayout>

        <!-- LAYAR 1: BERANDA STATUS, IZIN & DISCLAIMER -->
        <LinearLayout
            android:id="@+id/viewHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CARD PERINGATAN RESMI & PENAFIAN TANGGUNG JAWAB (COMPACT & COLLAPSIBLE DI ATAS) -->
            <LinearLayout
                android:id="@+id/layoutDisclaimerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_warning_card"
                android:padding="12dp"
                android:elevation="1dp"
                android:layout_marginBottom="14dp">

                <!-- Header Bar Ringkas (Selalu Tampak) -->
                <LinearLayout
                    android:id="@+id/layoutDisclaimerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ketentuan &amp; Penafian Admin"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:textColor="#C2410C" />

                        <TextView
                            android:id="@+id/tvDisclaimerHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hanya jual alat bantu · Risiko banned tanggung jawab user"
                            android:textSize="9.5sp"
                            android:textColor="#9A3412" />
                    </LinearLayout>

                    <!-- Tombol Sembunyikan / Lihat -->
                    <TextView
                        android:id="@+id/btnToggleDisclaimer"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Buka ▼"
                        android:textColor="#0F172A"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Body Ketentuan Lengkap (Bisa Disembunyikan / GONE) -->
                <LinearLayout
                    android:id="@+id/layoutDisclaimerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="10dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#FED7AA"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Batasan Layanan Penjual:\nAdmin/Penjual semata-mata hanya menyediakan dan menjual lisensi software alat bantu pengetikan otomatis mandiri (accessibility assistant tool).\n\n2. Pelepasan Tanggung Jawab:\nAdmin TIDAK BERTANGGUNG JAWAB atas segala tindakan, isi percakapan, frekuensi pesan, maupun konsekuensi teknis/hukum dari pemakaian aplikasi ini.\n\n3. Risiko Akun Platform (Banned):\nSegala risiko akun TikTok—termasuk mute komentar, pembatasan live, shadowban, hingga pemblokiran permanen (banned)—sepenuhnya risiko mandiri pengguna di luar tanggung jawab Admin.\n\n4. Tanggung Jawab Pribadi (Use at Your Own Risk):\nSeluruh operasional merupakan kesadaran pribadi pembeli. Disarankan selalu mengatur jeda wajar (minimal 4–8 detik) dan mengaktifkan fitur Anti-Spam.\n\n5. Persetujuan Mutlak:\nMenggunakan aplikasi ini menandakan persetujuan penuh dan membebaskan Admin dari segala tuntutan."
                        android:textSize="10sp"
                        android:textColor="#7C2D12"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD STATUS LISENSI & TRIAL 3 HARI -->
            <LinearLayout
                android:id="@+id/cardLicenseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLicenseIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👑"
                        android:textSize="18sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLicenseTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lisensi &amp; Akses Aplikasi"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#090A0F" />

                        <TextView
                            android:id="@+id/tvLicenseSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Masa Uji Coba 3 Hari atau Seumur Hidup"
                            android:textSize="10sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/badgeLicenseStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="TRIAL 3 HARI"
                        android:textColor="#0F172A"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Box Detail Countdown & Status Waktu -->
                <LinearLayout
                    android:id="@+id/layoutLicenseCountdownBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F8FAFC"
                    android:padding="10dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvLicenseTimeRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sisa Waktu Trial: Memuat data..."
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/tvLicenseDeviceBoundInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: DEV-XXXX · IP: 127.0.0.1"
                        android:textSize="9.5sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Tombol Aksi: Klaim Trial 3 Hari Gratis -->
                <Button
                    android:id="@+id/btnClaimTrialAction"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_trial"
                    android:text="🎁  Klaim Uji Coba 3 Hari Gratis"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Tombol Aksi: Beli Lisensi Seumur Hidup 10 Ribu -->
                <Button
                    android:id="@+id/btnBuyLifetimeAction"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_gold"
                    android:text="👑  Beli Lisensi Seumur Hidup — Rp 10.000"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="10dp" />

                <!-- Disclaimer Terikat Device -->
                <TextView
                    android:id="@+id/tvLicenseDeviceWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="*Peringatan: Lisensi dikunci permanen pada Device ID ini. Pembelian hanya berlaku untuk perangkat ini dan tidak dapat dipindahkan."
                    android:textSize="9sp"
                    android:textColor="#94A3B8"
                    android:lineSpacingExtra="1dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Card Status Utama -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_tiktok_official"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="TikTok" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sistem Siap"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <TextView
                        android:id="@+id/tvStatusSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semua izin terhubung"
                        android:textSize="11.5sp"
                        android:textColor="#10B981"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_indicator_dot" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IZIN DIPERLUKAN"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Card 1: Overlay -->
            <LinearLayout
                android:id="@+id/cardOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Layar Melayang"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Widget bubble di atas TikTok"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Card 2: Aksesibilitas -->
            <LinearLayout
                android:id="@+id/cardAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aksesibilitas"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-ketik &amp; kirim komentar"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLaunchFloating"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Mulai"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_tiktok_gradient"
                android:elevation="2dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- LAYAR 2: PENGATURAN LENGKAP -->
        <LinearLayout
            android:id="@+id/viewSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PESAN ROTASI"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic Message Inputs Container -->
            <LinearLayout
                android:id="@+id/containerMessageSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="12dp"
                android:elevation="1dp"
                android:layout_marginBottom="8dp" />

            <!-- Tombol Tambah Pesan di Pengaturan -->
            <TextView
                android:id="@+id/btnSettingsAddMessage"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="+ Tambah Pesan Rotasi Baru"
                android:textColor="#FE2C55"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_white_card"
                android:elevation="1dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JEDA &amp; TARGET BATAS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="6dp" />

            <!-- Card Setting Delay & Target Limit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <!-- Jeda Waktu with Plus & Minus Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Jeda Pengiriman (Detik)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <!-- Stepper Delay -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_input_white"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/btnSettingDelayMinus"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_stepper_btn"
                            android:gravity="center"
                            android:text="−"
                            android:textColor="#090A0F"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etSettingDelay"
                            android:layout_width="42dp"
                            android:layout_height="match_parent"
                            android:text="4"
                            android:gravity="center"
                            android:textColor="#090A0F"
                            android:background="@null"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:inputType="number" />

                        <TextView
                            android:id="@+id/btnSettingDelayPlus"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_stepper_btn"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#090A0F"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <!-- Target Batas Jumlah Pesan with Plus & Minus Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Batas Pesan"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#090A0F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 = Tanpa batas (Stop otomatis)"
                            android:textSize="10.5sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Stepper Target -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_input_white"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/btnSettingMaxMinus"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_stepper_btn"
                            android:gravity="center"
                            android:text="−"
                            android:textColor="#090A0F"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etSettingMaxCount"
                            android:layout_width="44dp"
                            android:layout_height="match_parent"
                            android:text="0"
                            android:gravity="center"
                            android:textColor="#090A0F"
                            android:background="@null"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:inputType="number" />

                        <TextView
                            android:id="@+id/btnSettingMaxPlus"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_stepper_btn"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#090A0F"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <!-- Anti-Spam Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anti-Spam Cerdas"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#090A0F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="200+ emoji acak &amp; zero-width code unik"
                            android:textSize="10.5sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAntiSpam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KALIBRASI KOORDINAT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Card Koordinat Kalibrasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvSettingsCoordStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Menggunakan Default TikTok Live"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#090A0F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kalibrasi pin bisa dibuka langsung di widget melayang saat di atas TikTok."
                    android:textSize="10.5sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnSettingsResetCoords"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="↩ Reset Koordinat ke Default TikTok"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:background="@drawable/bg_input_white"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Simpan Semua Pengaturan 💾"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_black"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

    <!-- OVERLAY FULLSCREEN KONEKSI OFFLINE (AUTO-DETECT REALTIME & LOADING BERPUTAR) -->
    <LinearLayout
        android:id="@+id/layoutOfflineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <!-- Indeterminate Loading Spinner Berputar-putar Halus -->
        <ProgressBar
            android:id="@+id/pbOfflineSpinner"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminateTint="#FE2C55"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="36sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Koneksi Internet Terputus"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aplikasi memerlukan koneksi internet aktif untuk sinkronisasi lisensi dan verifikasi realtime.\n\nSilakan aktifkan Data Seluler atau WiFi Anda."
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_stepper_btn"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="16dp">

            <ProgressBar
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:indeterminateTint="#10B981"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mendeteksi koneksi secara otomatis..."
                android:textSize="10.5sp"
                android:textColor="#059669"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenNetworkSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_black"
            android:text="Buka Pengaturan Jaringan / WiFi"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:layout_marginTop="20dp" />
    </LinearLayout>

</FrameLayout>
