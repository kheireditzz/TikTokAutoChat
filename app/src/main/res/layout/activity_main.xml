<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER BAR (PUTIH BERSIH) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AutoChat"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#090A0F"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tvHeaderSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIKTOK ASSISTANT"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHeaderAction"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_btn_white"
                android:src="@drawable/ic_tab_settings"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Pengaturan" />
        </LinearLayout>

        <!-- LAYAR 1: BERANDA STATUS & IZIN -->
        <LinearLayout
            android:id="@+id/viewHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Status Utama -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_tiktok_official"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="TikTok" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sistem Siap"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <TextView
                        android:id="@+id/tvStatusSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semua izin terhubung"
                        android:textSize="11.5sp"
                        android:textColor="#10B981"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_indicator_dot" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IZIN DIPERLUKAN"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Card 1: Overlay -->
            <LinearLayout
                android:id="@+id/cardOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Layar Melayang"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Widget bubble di atas TikTok"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Card 2: Aksesibilitas -->
            <LinearLayout
                android:id="@+id/cardAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aksesibilitas"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-ketik &amp; kirim komentar"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLaunchFloating"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Buka Widget Melayang  →"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_black"
                android:elevation="2dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- LAYAR 2: PENGATURAN LENGKAP -->
        <LinearLayout
            android:id="@+id/viewSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PESAN ROTASI"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic Message Inputs Container -->
            <LinearLayout
                android:id="@+id/containerMessageSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="12dp"
                android:elevation="1dp"
                android:layout_marginBottom="8dp" />

            <!-- Tombol Tambah Pesan di Pengaturan -->
            <TextView
                android:id="@+id/btnSettingsAddMessage"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="+ Tambah Pesan Rotasi Baru"
                android:textColor="#FE2C55"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_white_card"
                android:elevation="1dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JEDA &amp; TARGET BATAS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="6dp" />

            <!-- Card Setting Delay & Target Limit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <!-- Jeda Waktu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Jeda Antar Pesan (Detik)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <EditText
                        android:id="@+id/etSettingDelay"
                        android:layout_width="54dp"
                        android:layout_height="36dp"
                        android:text="4"
                        android:gravity="center"
                        android:textColor="#090A0F"
                        android:background="@drawable/bg_input_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="number" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <!-- Target Batas Jumlah Pesan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Batas Pesan"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#090A0F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 = Tanpa batas (Stop otomatis saat tercapai)"
                            android:textSize="10.5sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etSettingMaxCount"
                        android:layout_width="54dp"
                        android:layout_height="36dp"
                        android:text="0"
                        android:gravity="center"
                        android:textColor="#090A0F"
                        android:background="@drawable/bg_input_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="number" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <!-- Anti-Spam Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anti-Spam Cerdas"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#090A0F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="200+ emoji acak &amp; zero-width code unik"
                            android:textSize="10.5sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAntiSpam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KALIBRASI KOORDINAT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Card Koordinat Kalibrasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvSettingsCoordStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Menggunakan Default TikTok Live"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#090A0F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kalibrasi pin bisa dibuka langsung di widget melayang saat di atas TikTok."
                    android:textSize="10.5sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnSettingsResetCoords"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="↩ Reset Koordinat ke Default TikTok"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:background="@drawable/bg_input_white"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Simpan Semua Pengaturan 💾"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_black"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
