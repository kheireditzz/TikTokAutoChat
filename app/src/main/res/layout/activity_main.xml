<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TikTok AutoChat"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bot Balas &amp; Spam Chat Otomatis TikTok Live"
                    android:textSize="12.5sp"
                    android:textColor="#8B949E"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="#00D2FF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS SISTEM"
                android:textColor="#00D2FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvSystemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Periksa &amp; Aktifkan Izin di Bawah"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F0F6FC"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplikasi memerlukan 2 izin utama: Overlay (Layar Melayang) dan Aksesibilitas (Ketik Otomatis)."
                android:textSize="11.5sp"
                android:textColor="#8B949E"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Step 1: Overlay Permission -->
        <LinearLayout
            android:id="@+id/cardOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_field"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1. Izin Tampil di Atas Aplikasi"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvOverlayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wajib"
                    android:textColor="#FFA726"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memungkinkan widget mengambang tetap muncul di atas aplikasi TikTok agar bisa digeser dan dikontrol."
                android:textSize="12sp"
                android:textColor="#8B949E"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Buka Izin Overlay"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F0F6FC"
                android:background="@drawable/bg_circle_btn"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Step 2: Accessibility Permission -->
        <LinearLayout
            android:id="@+id/cardAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_field"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2. Izin Aksesibilitas (Ketik Otomatis)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvAccessibilityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wajib"
                    android:textColor="#FFA726"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENTING: Aktifkan 'AutoChat' di pengaturan Aksesibilitas agar robot dapat mengetik teks dan menekan tombol kirim di TikTok."
                android:textSize="12sp"
                android:textColor="#8B949E"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnGrantAccessibility"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Buka Pengaturan Aksesibilitas"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F0F6FC"
                android:background="@drawable/bg_circle_btn"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Launch Floating Widget Button -->
        <Button
            android:id="@+id/btnLaunchFloating"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚡ BUKA WIDGET MELAYANG"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_action_btn"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Fitur: Bisa diperkecil, digeser ke samping layar, &amp; atur pesan rotasi"
            android:textSize="11sp"
            android:textColor="#6E7681"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
