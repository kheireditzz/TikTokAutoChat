<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top App Bar (BERADA DI DALAM SCROLL SEHINGGA IKUT TERSCROLL KE BAWAH) -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp"
            android:background="#FFFFFF">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_tiktok_official"
                android:background="@drawable/bg_white_button"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AutoChat"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#090A0F"
                    android:letterSpacing="-0.03" />

                <TextView
                    android:id="@+id/tvHeaderSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIKTOK ASSISTANT"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Tombol Aksi di Kanan Atas: Gear saat di Beranda, Back saat di Pengaturan -->
            <ImageView
                android:id="@+id/btnHeaderAction"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tab_settings"
                android:tint="#0F172A"
                android:background="@drawable/bg_white_button"
                android:padding="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9" />

        <!-- LAYAR 1: BERANDA -->
        <LinearLayout
            android:id="@+id/viewHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Minimal Status Banner (Bersih tanpa bulatan) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sistem Siap"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="#090A0F" />

                <TextView
                    android:id="@+id/tvStatusSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semua izin terhubung"
                    android:textSize="11.5sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IZIN SISTEM"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Card 1: Overlay (Bersih tanpa bulatan) -->
            <LinearLayout
                android:id="@+id/cardOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Layar Melayang"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Widget overlay TikTok"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Card 2: Aksesibilitas (Bersih tanpa bulatan) -->
            <LinearLayout
                android:id="@+id/cardAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aksesibilitas"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-ketik &amp; kirim komentar"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLaunchFloating"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Buka Widget Melayang  →"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_black"
                android:elevation="2dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- LAYAR 2: PENGATURAN LENGKAP -->
        <LinearLayout
            android:id="@+id/viewSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PESAN ROTASI"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic Message Inputs Container -->
            <LinearLayout
                android:id="@+id/containerMessageSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="12dp"
                android:elevation="1dp"
                android:layout_marginBottom="8dp" />

            <!-- Tombol Tambah Pesan di Pengaturan -->
            <TextView
                android:id="@+id/btnSettingsAddMessage"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="+ Tambah Pesan Rotasi Baru"
                android:textColor="#FE2C55"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_white_card"
                android:elevation="1dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JEDA &amp; KEAMANAN"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="6dp" />

            <!-- Setting Delay & Anti-Banned Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Jeda Pengiriman (Detik)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#090A0F" />

                    <EditText
                        android:id="@+id/etSettingDelay"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:text="4"
                        android:gravity="center"
                        android:textColor="#090A0F"
                        android:background="@drawable/bg_input_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="number" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anti-Deteksi Bot"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#090A0F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Emoji &amp; jeda acak"
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAntiSpam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KOORDINAT MANUAL (PERSENTASE LAYAR)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Card Koordinat Manual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Titik Kolom Komentar Live (Bawah Kiri)"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#090A0F"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="X (% Lebar):"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <EditText
                        android:id="@+id/etCoordInputX"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:text="25"
                        android:gravity="center"
                        android:textColor="#090A0F"
                        android:background="@drawable/bg_input_white"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:inputType="number"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Y (% Tinggi):"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <EditText
                        android:id="@+id/etCoordInputY"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:text="96"
                        android:gravity="center"
                        android:textColor="#090A0F"
                        android:background="@drawable/bg_input_white"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:inputType="number"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Titik Tombol Kirim / Enter (Kanan Bawah)"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#090A0F"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="X (% Lebar):"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <EditText
                        android:id="@+id/etCoordSendX"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:text="92"
                        android:gravity="center"
                        android:textColor="#090A0F"
                        android:background="@drawable/bg_input_white"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:inputType="number"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Y (% Tinggi):"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <EditText
                        android:id="@+id/etCoordSendY"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:text="94"
                        android:gravity="center"
                        android:textColor="#090A0F"
                        android:background="@drawable/bg_input_white"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:inputType="number"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*Nilai dalam persen (0-100). Default: Komentar X:25 Y:96 | Kirim X:92 Y:94"
                    android:textSize="10.5sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Simpan Pengaturan 💾"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_black"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
