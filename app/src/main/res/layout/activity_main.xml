<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Clean Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@drawable/bg_white_card"
                android:padding="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TikTok AutoChat"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bot Balas &amp; Spam Chat Otomatis TikTok Live"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="#FE2C55"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="#FFE4E8"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />
        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STATUS SISTEM"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <View
                    android:id="@+id/mainStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_indicator_dot" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSystemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semua Sistem Siap Beroperasi!"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplikasi memerlukan 2 izin utama: Overlay (Layar Melayang) dan Aksesibilitas (Ketik Otomatis)."
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Step 1: Overlay Card (HANYA WARNA HIJAU/MERAH, TANPA TEKS PANJANG) -->
        <LinearLayout
            android:id="@+id/cardOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Izin Tampil di Atas Aplikasi"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memungkinkan widget mengambang tetap muncul di atas aplikasi TikTok agar bisa digeser dan dikontrol."
                        android:textSize="11.5sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Indikator Warna Garis Pill Saja (Hijau / Merah) -->
            <View
                android:id="@+id/indicatorOverlay"
                android:layout_width="38dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_indicator_pill"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Step 2: Accessibility Card (HANYA WARNA HIJAU/MERAH, TANPA TEKS PANJANG) -->
        <LinearLayout
            android:id="@+id/cardAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Izin Aksesibilitas (Ketik Otomatis)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PENTING: Aktifkan 'AutoChat' di pengaturan Aksesibilitas agar robot dapat mengetik teks dan menekan tombol kirim di TikTok."
                        android:textSize="11.5sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Indikator Warna Garis Pill Saja (Hijau / Merah) -->
            <View
                android:id="@+id/indicatorAccessibility"
                android:layout_width="38dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_indicator_pill"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Launch Floating Widget Button -->
        <Button
            android:id="@+id/btnLaunchFloating"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="BUKA WIDGET MELAYANG"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tiktok_gradient"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Fitur: Bisa diperkecil, digeser ke samping layar, &amp; atur pesan"
            android:textSize="11.5sp"
            android:textColor="#94A3B8"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
