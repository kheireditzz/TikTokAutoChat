<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_white_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💾 Simpan Preset Koordinat"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#090A0F"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvPresetCoordsSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chat: X:25% Y:96% | Kirim: X:92% Y:94%"
        android:textSize="11.5sp"
        android:textColor="#64748B"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NAMA PRESET / TEMPLATE:"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:textColor="#94A3B8"
        android:letterSpacing="0.08"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etPresetName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Contoh: TikTok Live Biasa, TikTok Live PK"
        android:textColor="#090A0F"
        android:textColorHint="#94A3B8"
        android:textSize="13sp"
        android:background="@drawable/bg_input_white"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelPreset"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Batal"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmSavePreset"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Simpan Preset"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_black"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</LinearLayout>
